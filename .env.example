# ==============================================================================
# OptiStop — Configuración de Entorno (Presupuesto $0 inicial, Cloud-Ready)
# ==============================================================================

# 1. Token de Moderación de Administración (Requerido para aprobar/rechazar en /admin, mín. 16 caracteres)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# 2. Persistencia Cloud Opcional (Supabase / PostgREST - RNF-09)
# Si se dejan vacíos, OptiStop usa automáticamente FileStopRepository (data/optistop-cache.db.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Proveedor Opcional Google Places API (Protegido por Quota Guard mensual - RNF-01)
# Si se deja vacío, OptiStop opera al 100% con BD Curada + OpenStreetMap Overpass ($0.00)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_MONTHLY_FREE_CALLS=150

# 4. Motor de Rutas OSRM (Por defecto usa https://router.project-osrm.org + fixtures locales)
OSRM_BASE_URL=https://router.project-osrm.org
